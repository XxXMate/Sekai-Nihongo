          "title": "Kalimat Pekerjaan (仕事を使った文・しごとをつかったぶん)",
          "words": [
            {
              "jp": "私は会社員です。",
              "romaji": "Watashi wa kaishain desu.",
              "meaning": "Saya pegawai perusahaan.",
              "audio": "私は会社員です。"
            },
            {
              "jp": "父は医者です。",
              "romaji": "Chichi wa isha desu.",
              "meaning": "Ayah saya seorang dokter.",
              "audio": "父は医者です。"
            },
            {
              "jp": "母は看護師です。",
              "romaji": "Haha wa kangoshi desu.",
              "meaning": "Ibu saya seorang perawat.",
              "audio": "母は看護師です。"
            },
            {
              "jp": "兄は先生です。",
              "romaji": "Ani wa sensei desu.",
              "meaning": "Kakak laki-laki saya seorang guru.",
              "audio": "兄は先生です。"
            },
            {
              "jp": "姉は銀行員です。",
              "romaji": "Ane wa ginkouin desu.",
              "meaning": "Kakak perempuan saya pegawai bank.",
              "audio": "姉は銀行員です。"
            },
            {
              "jp": "あの人は店員です。",
              "romaji": "Ano hito wa ten'in desu.",
              "meaning": "Orang itu pegawai toko.",
              "audio": "あの人は店員です。"
            },
            {
              "jp": "田中さんは警察官です。",
              "romaji": "Tanaka-san wa keisatsukan desu.",
              "meaning": "Tanaka adalah seorang polisi.",
              "audio": "田中さんは警察官です。"
            },
            {
              "jp": "父は運転手です。",
              "romaji": "Chichi wa untenshu desu.",
              "meaning": "Ayah saya seorang sopir.",
              "audio": "父は運転手です。"
            },
            {
              "jp": "兄は料理人です。",
              "romaji": "Ani wa ryourinin desu.",
              "meaning": "Kakak laki-laki saya seorang juru masak.",
              "audio": "兄は料理人です。"
            },
            {
              "jp": "私は会社で働いています。",
              "romaji": "Watashi wa kaisha de hataraite imasu.",
              "meaning": "Saya bekerja di perusahaan.",
              "audio": "私は会社で働いています。"
            },
            {
              "jp": "毎日、会社へ行きます。",
              "romaji": "Mainichi, kaisha e ikimasu.",
              "meaning": "Setiap hari saya pergi ke perusahaan.",
              "audio": "毎日、会社へ行きます。"
            },
            {
              "jp": "何の仕事をしていますか。",
              "romaji": "Nan no shigoto o shite imasu ka.",
              "meaning": "Apa pekerjaan Anda?",
              "audio": "何の仕事をしていますか。"
            },
            {
              "jp": "どこで働いていますか。",
