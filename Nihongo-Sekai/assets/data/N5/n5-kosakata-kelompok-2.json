            {
              "title": "Contoh Kalimat",
              "words": [
                {
                  "jp": "家族は四人です。",
                  "romaji": "Kazoku wa yonin desu.",
                  "meaning": "Keluarga saya ada empat orang.",
                  "audio": "家族は四人です。"
                },
                {
                  "jp": "父は会社員です。",
                  "romaji": "Chichi wa kaishain desu.",
                  "meaning": "Ayah saya pegawai perusahaan.",
                  "audio": "父は会社員です。"
                },
                {
                  "jp": "母は料理が上手です。",
                  "romaji": "Haha wa ryouri ga jouzu desu.",
                  "meaning": "Ibu saya pandai memasak.",
                  "audio": "母は料理が上手です。"
                },
                {
                  "jp": "両親は東京に住んでいます。",
                  "romaji": "Ryoushin wa Toukyou ni sunde imasu.",
                  "meaning": "Orang tua saya tinggal di Tokyo.",
                  "audio": "両親は東京に住んでいます。"
                },
                {
                  "jp": "兄は大学生です。",
                  "romaji": "Ani wa daigakusei desu.",
                  "meaning": "Kakak laki-laki saya mahasiswa.",
                  "audio": "兄は大学生です。"
                },
                {
                  "jp": "姉は先生です。",
                  "romaji": "Ane wa sensei desu.",
                  "meaning": "Kakak perempuan saya adalah guru.",
                  "audio": "姉は先生です。"
                },
                {
                  "jp": "弟は高校生です。",
                  "romaji": "Otouto wa koukousei desu.",
                  "meaning": "Adik laki-laki saya siswa SMA.",
                  "audio": "弟は高校生です。"
                },
                {
                  "jp": "妹は十歳です。",
                  "romaji": "Imouto wa jussai desu.",
                  "meaning": "Adik perempuan saya berusia sepuluh tahun.",
                  "audio": "妹は十歳です。"
                },
                {
                  "jp": "祖父は元気です。",
                  "romaji": "Sofu wa genki desu.",
                  "meaning": "Kakek saya sehat.",
                  "audio": "祖父は元気です。"
                },
                {
                  "jp": "祖母は花が好きです。",
                  "romaji": "Sobo wa hana ga suki desu.",
                  "meaning": "Nenek saya suka bunga.",
                  "audio": "祖母は花が好きです。"
                },
                {
                  "jp": "私には兄弟が二人います。",
                  "romaji": "Watashi ni wa kyoudai ga futari imasu.",
                  "meaning": "Saya memiliki dua saudara kandung.",
                  "audio": "私には兄弟が二人います。"
                },
                {
                  "jp": "私たちは姉妹です。",
                  "romaji": "Watashitachi wa shimai desu.",
                  "meaning": "Kami adalah saudara perempuan.",
                  "audio": "私たちは姉妹です。"
                },
                {
                  "jp": "息子は三歳です。",
                  "romaji": "Musuko wa sansai desu.",
                  "meaning": "Anak laki-laki saya berusia tiga tahun.",
                  "audio": "息子は三歳です。"
                },
                {
                  "jp": "娘は五歳です。",
                  "romaji": "Musume wa gosai desu.",
                  "meaning": "Anak perempuan saya berusia lima tahun.",
                  "audio": "娘は五歳です。"
                }
              ]
            }
