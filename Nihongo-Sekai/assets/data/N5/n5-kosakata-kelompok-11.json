        {
          "number": "11.2",
          "title": "Kalimat Bagian Tubuh (体についての文・からだについてのぶん)",
          "words": [
            {
              "jp": "頭が痛いです。",
              "romaji": "Atama ga itai desu.",
              "meaning": "Kepala saya sakit.",
              "audio": "頭が痛いです。"
            },
            {
              "jp": "おなかが痛いです。",
              "romaji": "Onaka ga itai desu.",
              "meaning": "Perut saya sakit.",
              "audio": "おなかが痛いです。"
            },
            {
              "jp": "歯が痛いです。",
              "romaji": "Ha ga itai desu.",
              "meaning": "Gigi saya sakit.",
              "audio": "歯が痛いです。"
            },
            {
              "jp": "手が痛いです。",
              "romaji": "Te ga itai desu.",
              "meaning": "Tangan saya sakit.",
              "audio": "手が痛いです。"
            },
            {
              "jp": "足が痛いです。",
              "romaji": "Ashi ga itai desu.",
              "meaning": "Kaki saya sakit.",
              "audio": "足が痛いです。"
            },
            {
              "jp": "髪が長いです。",
              "romaji": "Kami ga nagai desu.",
              "meaning": "Rambutnya panjang.",
              "audio": "髪が長いです。"
            },
            {
              "jp": "目が大きいです。",
              "romaji": "Me ga ookii desu.",
              "meaning": "Matanya besar.",
              "audio": "目が大きいです。"
            },
            {
              "jp": "耳が小さいです。",
              "romaji": "Mimi ga chiisai desu.",
              "meaning": "Telinganya kecil.",
              "audio": "耳が小さいです。"
            },
            {
              "jp": "鼻が高いです。",
              "romaji": "Hana ga takai desu.",
              "meaning": "Hidungnya mancung.",
              "audio": "鼻が高いです。"
            },
            {
              "jp": "口を開けてください。",
              "romaji": "Kuchi o akete kudasai.",
              "meaning": "Tolong buka mulut.",
              "audio": "口を開けてください。"
            },
            {
              "jp": "手を上げてください。",
              "romaji": "Te o agete kudasai.",
              "meaning": "Tolong angkat tangan.",
              "audio": "手を上げてください。"
            },
            {
              "jp": "指を見せてください。",
              "romaji": "Yubi o misete kudasai.",
              "meaning": "Tolong tunjukkan jari.",
              "audio": "指を見せてください。"
            },
            {
              "jp": "目は二つあります。",
              "romaji": "Me wa futatsu arimasu.",
              "meaning": "Mata ada dua.",
              "audio": "目は二つあります。"
            },
            {
              "jp": "耳は二つあります。",
              "romaji": "Mimi wa futatsu arimasu.",
              "meaning": "Telinga ada dua.",
              "audio": "耳は二つあります。"
            },
            {
              "jp": "指は十本あります。",
              "romaji": "Yubi wa juppon arimasu.",
              "meaning": "Jari ada sepuluh.",
              "audio": "指は十本あります。"
            }
          ]
        }
      ]
