        {
          "number": "9.2",
          "title": "Contoh Kalimat tentang Cuaca（天気を使った文・てんきをつかったぶん）",
          "words": [
            {
              "jp": "今日はいい天気です。",
              "romaji": "Kyou wa ii tenki desu.",
              "meaning": "Hari ini cuacanya bagus.",
              "audio": "今日はいい天気です。"
            },
            {
              "jp": "今日の天気はどうですか。",
              "romaji": "Kyou no tenki wa dou desu ka.",
              "meaning": "Bagaimana cuaca hari ini?",
              "audio": "今日の天気はどうですか。"
            },
            {
              "jp": "今日は晴れです。",
              "romaji": "Kyou wa hare desu.",
              "meaning": "Hari ini cerah.",
              "audio": "今日は晴れです。"
            },
            {
              "jp": "明日は曇りです。",
              "romaji": "Ashita wa kumori desu.",
              "meaning": "Besok mendung.",
              "audio": "明日は曇りです。"
            },
            {
              "jp": "昨日は雨でした。",
              "romaji": "Kinou wa ame deshita.",
              "meaning": "Kemarin hujan.",
              "audio": "昨日は雨でした。"
            },
            {
              "jp": "雨が降っています。",
              "romaji": "Ame ga futte imasu.",
              "meaning": "Hujan sedang turun.",
              "audio": "雨が降っています。"
            },
            {
              "jp": "雪が降っています。",
              "romaji": "Yuki ga futte imasu.",
              "meaning": "Salju sedang turun.",
              "audio": "雪が降っています。"
            },
            {
              "jp": "明日は雨が降ります。",
              "romaji": "Ashita wa ame ga furimasu.",
              "meaning": "Besok akan turun hujan.",
              "audio": "明日は雨が降ります。"
            },
            {
              "jp": "風が吹いています。",
              "romaji": "Kaze ga fuite imasu.",
              "meaning": "Angin sedang bertiup.",
              "audio": "風が吹いています。"
            },
            {
              "jp": "風が強いです。",
              "romaji": "Kaze ga tsuyoi desu.",
              "meaning": "Anginnya kencang.",
              "audio": "風が強いです。"
            },
            {
              "jp": "空が青いです。",
              "romaji": "Sora ga aoi desu.",
              "meaning": "Langit berwarna biru.",
              "audio": "空が青いです。"
            },
            {
              "jp": "雲が多いです。",
              "romaji": "Kumo ga ooi desu.",
              "meaning": "Awan banyak.",
              "audio": "雲が多いです。"
            },
            {
              "jp": "日本には四つの季節があります。",
              "romaji": "Nihon ni wa yottsu no kisetsu ga arimasu.",
              "meaning": "Di Jepang ada empat musim.",
              "audio": "日本には四つの季節があります。"
            },
            {
              "jp": "春は暖かいです。",
              "romaji": "Haru wa atatakai desu.",
              "meaning": "Musim semi hangat.",
              "audio": "春は暖かいです。"
            },
            {
              "jp": "夏は暑いです。",
              "romaji": "Natsu wa atsui desu.",
              "meaning": "Musim panas panas.",
              "audio": "夏は暑いです。"
            },
            {
              "jp": "秋は涼しいです。",
              "romaji": "Aki wa suzushii desu.",
              "meaning": "Musim gugur sejuk.",
              "audio": "秋は涼しいです。"
            },
            {
              "jp": "冬は寒いです。",
              "romaji": "Fuyu wa samui desu.",
              "meaning": "Musim dingin dingin.",
              "audio": "冬は寒いです。"
            }
          ]
        }
      ]
